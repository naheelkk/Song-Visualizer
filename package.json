{
  "name": "prism-audio-visualizer",
  "productName": "Prism",
  "version": "1.0.0",
  "private": true,
  "description": "A modern audio visualizer and player with 23 reactive scenes, an equalizer and a built-in player, for Windows and the web.",
  "author": "Prism",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "start": "electron .",
    "app:dev": "node electron/dev.mjs",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir"
  },
  "devDependencies": {
    "electron": "^45.4.1",
    "electron-builder": "^26.18.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "build": {
    "appId": "com.prism.audio",
    "productName": "Prism",
    "copyright": "Copyright © 2026 Prism",
    "asar": true,
    "compression": "normal",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**/*",
      "build/icon.png",
      "electron/main.cjs",
      "electron/preload.cjs",
      "package.json"
    ],
    "win": {
      "icon": "build/icon.png",
      "target": [
        "nsis",
        "portable"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Prism",
      "artifactName": "Prism-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "Prism-Portable-${version}.${ext}"
    }
  }
}
